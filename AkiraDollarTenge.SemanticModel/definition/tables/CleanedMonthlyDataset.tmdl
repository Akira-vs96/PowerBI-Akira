table CleanedMonthlyDataset
	lineageTag: 1aaf3365-2616-404c-a913-5caa2e69e3d3

	measure 'Средний курс' = AVERAGE('CleanedMonthlyDataset'[usd_kzt])
		formatString: 0.00
		lineageTag: b35f69a4-4a39-4ad4-b5a3-a0be3647f366

	measure 'Максимальный курс' = MAX('CleanedMonthlyDataset'[usd_kzt])
		formatString: 0.00
		lineageTag: 464fce36-31d7-4738-a46b-7f4f9ccab96a

